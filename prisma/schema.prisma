generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  priority  Priority @default(MEDIUM)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("tasks")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
